# Copy to .env and chmod 600. Never reuse JAFAR bot credentials.
AFTERBURNER_TELEGRAM_BOT_TOKEN=
AFTERBURNER_TELEGRAM_CHAT_ID=
AFTERBURNER_DATA_DIR=
# 1 suppresses every alert (including health warnings) while collecting samples
AFTERBURNER_NO_ALERTS=0

# Optional additional chat IDs (e.g., friends). They can request status; they do
# NOT receive push trading alerts. Never open the bot to arbitrary chat IDs.
AFTERBURNER_TELEGRAM_ALLOWED_CHAT_IDS=
# Set for /meme@BotUsername support inside groups; no @ prefix required.
AFTERBURNER_TELEGRAM_BOT_USERNAME=
# Optional HTTPS link returned to allowlisted users by /link.
AFTERBURNER_PUBLIC_URL=
